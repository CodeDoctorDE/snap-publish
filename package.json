{
  "name": "snapcraft-publish-action",
  "version": "1.2.0",
  "private": true,
  "description": "A Github action that publishes snapcraft projects",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src",
    "pack": "ncc build",
    "test": "jest",
    "all": "npm run build && npm run format-check && npm run lint && npm run pack && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeDoctorDE/snap-publish.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup"
  ],
  "author": "James Henstridge",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/exec": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.15.0",
    "jest": "^30.0.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=24"
  }
}
